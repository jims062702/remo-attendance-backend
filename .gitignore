/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
# Every .env variant is ignored, and .env.example is the single exception.
# Listing files individually is how a secret eventually gets committed: the
# next .env.<something> anyone adds is tracked by default. .env.render holds
# the production database password and the Google client secret.
.env
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
