<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Pinned to match production.

            With debug on, the exception handler in bootstrap/app.php returns
            early and every failure renders with its natural status. With it
            off, which is how the application actually ships, unrecognised
            exceptions are flattened to a generic 500. Those are two different
            error surfaces, and testing only the forgiving one is how a bug
            that turned every 422 into a 500 reached production unnoticed.
        -->
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against a real MariaDB schema, not SQLite: the attendance
             rules depend on genuine unique-index violations and ENUM/DECIMAL
             behaviour that SQLite does not reproduce faithfully. -->
        <!--
            Empty roster, meaning every night runs.

            The suite is built around 2026-07-26, which happens to be a Sunday,
            and almost none of these tests are about the roster. They are about
            clocking in, hours, reports and exports. Leaving the real Tuesday
            to Saturday roster in place would fail three hundred tests on the
            weekday of a fixture date chosen arbitrarily, which teaches nobody
            anything.

            WorkingDaysTest sets the real roster itself. That is also what
            makes it readable: the days under test are named in the test rather
            than inherited from configuration.
        -->
        <env name="ATTENDANCE_WORKING_DAYS" value=""/>
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_DATABASE" value="remo_attendance_test"/>
        <env name="APP_TIMEZONE" value="Asia/Manila"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
