APP_NAME="Remo Attendance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# All attendance timestamps are recorded in this timezone. Changing it after
# records exist will reinterpret stored datetimes -- do not change casually.
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8001

# Origin of the Vite dev server. Used for CORS + Sanctum stateful domains.
FRONTEND_URL=http://localhost:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remo_attendance
DB_USERNAME=root
DB_PASSWORD=

# Session-based (cookie) auth via Sanctum SPA mode.
#
# SCALE: `database` is fine for development and for a floor of a few hundred.
# It is NOT viable for a full concurrent floor -- every authenticated request
# does a SELECT and an UPDATE against a single `sessions` row, so the table
# becomes the busiest write target in the system and its row locks serialise
# requests that have nothing to do with each other. Switch to `redis` before
# going wide; see "Running at scale" in the README.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174,localhost:8001,127.0.0.1:8001

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# SCALE: the PC picker and the daily reference lists are cached, and both are
# read by every tasker. On the `database` store those reads are themselves
# queries -- still far cheaper than the work they replace, but the win is much
# larger on `redis`.
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@remoattendance.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shift / attendance business rules (see config/attendance.php) ---
# Overnight graveyard shift: 10:00 PM -> 6:00 AM (next calendar day).
# Clock-ins before BUSINESS_DAY_CUTOFF are attributed to the previous
# business date, so a 12:30 AM arrival still belongs to last night's shift.
ATTENDANCE_SHIFT_START=22:00
ATTENDANCE_SHIFT_END=06:00
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_STANDARD_HOURS=8
ATTENDANCE_BUSINESS_DAY_CUTOFF=12:00
ATTENDANCE_MAX_SHIFT_HOURS=16

# --- Google Sign-In (the only way into the application) ---
# Create an OAuth 2.0 Client ID ("Web application") at
# https://console.cloud.google.com/apis/credentials and register this exact
# redirect URI under "Authorised redirect URIs":
#     http://localhost:8001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
# Optional: restrict sign-in to one or more email domains, e.g. "acme.com,acme.ph"
GOOGLE_ALLOWED_DOMAINS=
