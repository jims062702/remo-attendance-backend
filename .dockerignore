# Keep the build context small and, more importantly, keep secrets and local
# state out of the image entirely.

.env
.env.*
!.env.example

vendor/
node_modules/

# Local state that must never ship: the SQLite scratch database, uploaded
# import files, cached views and logs.
storage/app/private/imports/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
database/database.sqlite

bootstrap/cache/*.php

tests/
phpunit.xml
.git/
.gitignore
README.md
